# Skopiuj do .env (robi to `make setup`) i dostosuj. Nie commituj .env – może zawierać klucze API.

# ---------------------------------------------------------------- LLM: lokalna Ollama (domyślnie)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# 8 GB RAM: qwen3.5:4b (lub qwen3.5:2b) · 16 GB+: qwen3.5:9b
LLM_MODEL=qwen3.5:4b
# "none" wyłącza tryb thinking w qwen3.5 (odpowiedź w ułamku sekundy zamiast kilkudziesięciu s).
# Zostaw puste, jeśli provider nie obsługuje parametru reasoning_effort.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0

# ---------------------------------------------------------------- Embedding
# Domyślnie ten sam serwer co LLM (EMBED_BASE_URL / EMBED_API_KEY = LLM_*).
EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_BASE_URL=
# EMBED_API_KEY=
# Instrukcja doklejana do zapytań (qwen3-embedding). Dla innych modeli ustaw pustą.
# EMBED_QUERY_INSTRUCTION=Given a question, retrieve passages from the documents that answer it

# ---------------------------------------------------------------- Gemini API (słabszy laptop)
# Klucz: https://aistudio.google.com/apikey  (UWAGA: free tier = dane mogą służyć do trenowania!)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=twoj-klucz
# LLM_MODEL=gemini-2.5-flash   # sprawdź aktualne nazwy: https://ai.google.dev/gemini-api/docs/models
# LLM_REASONING_EFFORT=
# EMBED_MODEL=gemini-embedding-001
# EMBED_QUERY_INSTRUCTION=
# Po zmianie EMBED_MODEL: make ingest ARGS=--recreate

# ---------------------------------------------------------------- Dane
# Katalog z dokumentami dla `make ingest` (PDF/MD/TXT, rekurencyjnie).
# Przykład „Regulamin PW”: dokumenty z manifestu w data/raw (make fetch-data).
DATA_DIR=data/raw

# ---------------------------------------------------------------- Vector store
# Serwer z docker-compose (make up) albo tryb bez Dockera: QDRANT_URL=local:./.qdrant
QDRANT_URL=http://localhost:6333
# Kolekcje przykładu: regulamin_structure (chunking po §/ust.) i regulamin_fixed (make ingest-regulamin)
COLLECTION=regulamin_structure

# ---------------------------------------------------------------- RAG
TOP_K=5
CHUNKING=structure
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# auto (native → prompt, wykryty tryb w .cache/, reset: make reset-cache) | native | tool | prompt
STRUCTURED_OUTPUT=auto
